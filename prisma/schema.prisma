generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./pos.db"
}

model Business {
  id        String   @id @default(uuid())
  name      String
  address   String?
  phone     String?
  email     String?
  logo      String?
  currency  String   @default("PKR")
  taxRate   Float    @default(0.0)
  taxName   String   @default("Tax")
  receiptFooter String?
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

model User {
  id           String        @id @default(uuid())
  businessId   String
  roleId       String
  username     String        @unique
  passwordHash String
  fullName     String
  pin          String?
  isActive     Boolean       @default(true)
  isDeleted    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  business     Business      @relation(fields: [businessId], references: [id])
  role         Role          @relation(fields: [roleId], references: [id])
  sales        Sale[]
  inventoryMovements InventoryMovement[]
  activityLogs ActivityLog[]
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  permissions String
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  parentId  String?
  isActive  Boolean   @default(true)
  isDeleted Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  parent    Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  products  Product[]
}

model Brand {
  id        String    @id @default(uuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  isDeleted Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id          String           @id @default(uuid())
  categoryId  String
  brandId     String?
  supplierId  String?
  name        String
  slug        String
  description String?
  isActive    Boolean          @default(true)
  isDeleted   Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  category    Category         @relation(fields: [categoryId], references: [id])
  brand       Brand?           @relation(fields: [brandId], references: [id])
  supplier    Supplier?        @relation(fields: [supplierId], references: [id])
  variants    ProductVariant[]
  images      ProductImage[]
}

model ProductVariant {
  id              String              @id @default(uuid())
  productId       String
  sku             String              @unique
  barcode         String?
  name            String
  costPrice       Float               @default(0)
  sellingPrice    Float               @default(0)
  stockQuantity   Float               @default(0)
  lowStockAlert   Float               @default(5)
  weight          String?
  size            String?
  color           String?
  isActive        Boolean             @default(true)
  isDeleted       Boolean             @default(false)
  woocommerceProductId  String?
  woocommerceVariationId String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  product         Product             @relation(fields: [productId], references: [id])
  saleItems       SaleItem[]
  inventoryMovements InventoryMovement[]
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  variantId String?
  url       String
  isPrimary Boolean  @default(false)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
}

model Customer {
  id          String   @id @default(uuid())
  fullName    String
  phone       String?
  email       String?
  address     String?
  city        String?
  notes       String?
  totalSpent  Float    @default(0)
  isWalkIn    Boolean  @default(false)
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sales       Sale[]
}

model Supplier {
  id          String    @id @default(uuid())
  name        String
  contactPerson String?
  phone       String?
  email       String?
  address     String?
  notes       String?
  isActive    Boolean   @default(true)
  isDeleted   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Sale {
  id           String     @id @default(uuid())
  customerId   String
  userId       String
  invoiceNo    String     @unique
  subtotal     Float
  discountRate Float      @default(0)
  discountAmt  Float      @default(0)
  taxRate      Float      @default(0)
  taxAmt       Float      @default(0)
  grandTotal   Float
  totalPaid    Float      @default(0)
  change       Float      @default(0)
  status       String     @default("completed")
  note         String?
  isDeleted    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  customer     Customer   @relation(fields: [customerId], references: [id])
  user         User       @relation(fields: [userId], references: [id])
  items        SaleItem[]
  payments     Payment[]
}

model SaleItem {
  id          String         @id @default(uuid())
  saleId      String
  variantId   String
  productName String
  variantName String
  sku         String
  quantity    Float
  unitPrice   Float
  discount    Float          @default(0)
  lineTotal   Float
  isDeleted   Boolean        @default(false)
  sale        Sale           @relation(fields: [saleId], references: [id])
  variant     ProductVariant @relation(fields: [variantId], references: [id])
}

model Payment {
  id          String   @id @default(uuid())
  saleId      String
  method      String
  amount      Float
  reference   String?
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  sale        Sale     @relation(fields: [saleId], references: [id])
}

model InventoryMovement {
  id          String         @id @default(uuid())
  variantId   String
  userId      String
  type        String
  quantity    Float
  previousQty Float
  newQty      Float
  reason      String?
  reference   String?
  isDeleted   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  user        User           @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  entity    String
  entityId  String?
  details   String?
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}
